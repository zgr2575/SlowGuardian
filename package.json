{
  "name": "slowguardian",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "description": "A fast, search-first web proxy with games, apps and privacy tools.",
  "author": "zgr2575",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/copy-proxy-assets.js",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:relays": "node --test --test-timeout=20000 \"tests/relays/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@mercuryworkshop/bare-as-module3": "2.2.5",
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/epoxy-transport": "2.1.28",
    "@mercuryworkshop/scramjet": "1.1.0",
    "@mercuryworkshop/wisp-js": "0.5.0",
    "@titaniumnetwork-dev/ultraviolet": "3.2.10",
    "@tomphttp/bare-server-node": "2.0.6",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lucide/svelte": "^1.47.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
