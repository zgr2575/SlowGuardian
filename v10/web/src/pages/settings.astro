---
/**
 * settings.astro — a plain settings list (no marketing copy).
 *
 * Theme (dark/light) and accent are wired by the Base shell via the shared ids
 * #themeSeg / #swatches. This page owns Performance mode, the search-engine
 * picker, and the privacy quick-actions exposed on window.SG.
 */
import Base from "../layouts/Base.astro";
---

<Base title="Settings — SlowGuardian" description="Appearance, performance, search, and privacy — all applied live on this device.">
  <section class="set-page">
    <div class="wrap set-wrap">
      <div class="set-list glass reveal">
        <div class="set-row">
          <span class="set-label">Appearance</span>
          <div class="segmented" id="themeSeg" style="background:var(--glass);">
            <button data-theme="dark" class="on">Dark</button>
            <button data-theme="light">Light</button>
          </div>
        </div>

        <div class="set-row">
          <span class="set-label">Accent</span>
          <div class="swatches" id="swatches">
            <button class="sw on" data-a="blue" aria-label="Blue"></button>
            <button class="sw" data-a="indigo" aria-label="Indigo"></button>
            <button class="sw" data-a="teal" aria-label="Teal"></button>
            <button class="sw" data-a="rose" aria-label="Rose"></button>
          </div>
        </div>

        <div class="set-row">
          <div>
            <div class="set-label">Performance</div>
            <div class="set-sub" id="perfNote"></div>
          </div>
          <div class="segmented" id="perfSeg" style="background:var(--glass);">
            <button data-perf="auto">Auto</button>
            <button data-perf="high">Full</button>
            <button data-perf="low">Lite</button>
          </div>
        </div>

        <div class="set-row">
          <span class="set-label">Search engine</span>
          <select id="engineSel" class="selctl" aria-label="Search engine">
            <option value="">Google</option>
            <option value="https://www.bing.com/search?q=%s">Bing</option>
            <option value="https://duckduckgo.com/?q=%s">DuckDuckGo</option>
            <option value="https://www.startpage.com/sp/search?query=%s">Startpage</option>
            <option value="https://search.brave.com/search?q=%s">Brave</option>
            <option value="https://www.ecosia.org/search?q=%s">Ecosia</option>
            <option value="custom">Custom…</option>
          </select>
        </div>

        <div class="set-row" id="engineCustomRow" style="display:none;">
          <span class="set-label">Custom search URL</span>
          <label class="field glass" style="flex:0 1 320px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
            <input id="engineCustom" type="text" placeholder="https://…/?q=%s" spellcheck="false" />
          </label>
        </div>

        <div class="set-row">
          <div>
            <div class="set-label">Tab disguise</div>
            <div class="set-sub">Show a fake tab title &amp; icon</div>
          </div>
          <button class="btn sm" id="cloakToggle2" type="button" style="background:var(--glass);color:var(--ink)">Toggle</button>
        </div>

        <div class="set-row">
          <div>
            <div class="set-label">Privacy &amp; quick exit</div>
            <div class="set-sub">Panic key, decoy site, about:blank</div>
          </div>
          <a class="btn sm" href="/privacy" style="background:var(--glass);color:var(--ink)">Open</a>
        </div>

        <div class="set-row">
          <div>
            <div class="set-label">Clear data</div>
            <div class="set-sub">Wipe local settings &amp; cache</div>
          </div>
          <button class="btn sm" id="clearTraces" type="button" style="background:var(--glass);color:var(--ink)">Clear</button>
        </div>

        <div class="set-row">
          <span class="set-label">Version</span>
          <span class="set-val">10.0.0</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    .set-page { padding: 84px 0 var(--sp-6); }
    .set-wrap { max-width: 720px; }
    .set-list { border-radius: var(--r-lg); overflow: hidden; }
    .set-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px var(--sp-5); flex-wrap: wrap; }
    .set-row + .set-row { border-top: 1px solid var(--glass-brd); }
    .set-label { font-size: 14.5px; font-weight: 500; color: var(--ink); }
    .set-sub { font-size: 12.5px; color: var(--ink-3); margin-top: 3px; }
    .set-val { font-size: 13.5px; color: var(--ink-2); }
    .selctl { background: var(--glass); border: 1px solid var(--glass-brd); color: var(--ink); border-radius: var(--r-pill);
      padding: 8px 14px; font-family: var(--font); font-size: 13px; font-weight: 500; cursor: pointer; }
    .selctl:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  </style>

  <script>
    /* Performance mode, search engine, and privacy quick-actions. Theme/accent
       are wired by the Base shell (#themeSeg / #swatches). */
    (function () {
      const root = document.documentElement;
      const w = window as any;
      function lsGet(k: string) { try { return localStorage.getItem(k); } catch (e) { return null; } }
      function lsSet(k: string, v: string) { try { localStorage.setItem(k, v); } catch (e) {} }
      function lsDel(k: string) { try { localStorage.removeItem(k); } catch (e) {} }
      function toast(m: string) { if (w.SG && w.SG.toast) w.SG.toast(m); }

      function autoDetect(): "low" | "high" {
        const mem = (navigator as any).deviceMemory;
        const cores = navigator.hardwareConcurrency;
        return ((mem && mem <= 2) || (cores && cores <= 2)) ? "low" : "high";
      }
      function currentPerf(): "auto" | "high" | "low" {
        const p = lsGet("sg:perf");
        return p === "low" || p === "high" ? p : "auto";
      }
      const perfSeg = document.getElementById("perfSeg");
      const perfNote = document.getElementById("perfNote");
      function reflectPerf(mode: string) {
        if (perfSeg) perfSeg.querySelectorAll("[data-perf]").forEach((b: any) => b.classList.toggle("on", b.getAttribute("data-perf") === mode));
        if (perfNote) {
          perfNote.textContent = mode === "auto"
            ? "Auto — picks the best for this device"
            : mode === "low" ? "Lite — no blur, best on old machines" : "Full — all effects on";
        }
      }
      function applyPerf(mode: string) {
        if (mode === "low") { lsSet("sg:perf", "low"); root.dataset.perf = "low"; }
        else if (mode === "high") { lsSet("sg:perf", "high"); root.removeAttribute("data-perf"); }
        else { lsDel("sg:perf"); if (autoDetect() === "low") root.dataset.perf = "low"; else root.removeAttribute("data-perf"); }
        reflectPerf(mode);
      }
      if (perfSeg) {
        reflectPerf(currentPerf());
        perfSeg.addEventListener("click", (e: any) => { const b = e.target.closest("[data-perf]"); if (b) applyPerf(b.getAttribute("data-perf")); });
      }

      const cloak2 = document.getElementById("cloakToggle2");
      if (cloak2) cloak2.addEventListener("click", () => { if (w.SG && w.SG.toggleCloak) w.SG.toggleCloak(); });
      const clr = document.getElementById("clearTraces");
      if (clr) clr.addEventListener("click", () => { if (w.SG && w.SG.clearTraces) w.SG.clearTraces(); });

      /* search engine (sg:engine = URL template with %s; empty = Google) */
      const engineSel = document.getElementById("engineSel") as HTMLSelectElement | null;
      const engineRow = document.getElementById("engineCustomRow");
      const engineCustom = document.getElementById("engineCustom") as HTMLInputElement | null;
      const PRESET_ENGINES = [
        "https://www.bing.com/search?q=%s",
        "https://duckduckgo.com/?q=%s",
        "https://www.startpage.com/sp/search?query=%s",
        "https://search.brave.com/search?q=%s",
        "https://www.ecosia.org/search?q=%s",
      ];
      function showCustom(on: boolean) { if (engineRow) engineRow.style.display = on ? "flex" : "none"; }
      if (engineSel) {
        const cur = lsGet("sg:engine") || "";
        if (!cur) engineSel.value = "";
        else if (PRESET_ENGINES.indexOf(cur) > -1) engineSel.value = cur;
        else { engineSel.value = "custom"; showCustom(true); if (engineCustom) engineCustom.value = cur; }
        engineSel.addEventListener("change", () => {
          if (engineSel.value === "custom") { showCustom(true); if (engineCustom) engineCustom.focus(); return; }
          showCustom(false);
          if (!engineSel.value) lsDel("sg:engine"); else lsSet("sg:engine", engineSel.value);
          toast("Search engine updated");
        });
      }
      if (engineCustom) {
        const saveCustom = () => {
          let v = engineCustom.value.trim();
          if (!v) { lsDel("sg:engine"); return; }
          if (v.indexOf("%s") < 0) v += (v.indexOf("?") < 0 ? "?q=%s" : "&q=%s");
          if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(v)) v = "https://" + v;
          lsSet("sg:engine", v);
          toast("Custom search engine saved");
        };
        engineCustom.addEventListener("change", saveCustom);
        engineCustom.addEventListener("blur", saveCustom);
      }
    })();
  </script>
</Base>
