---
/**
 * settings.astro — Appearance, performance, privacy & about.
 *
 * Theme (dark/light) and accent are wired by the Base shell via the shared
 * ids #themeSeg / #swatches (persist sg:theme / sg:accent, flip data-theme /
 * data-accent live). This page owns Performance mode (sg:perf → data-perf)
 * and surfaces the privacy actions the Base shell exposes on window.SG.
 *
 * Layout follows the approved mockup: appearance bar + a three-card grid
 * (Performance · Privacy & exit · About).
 */
import Base from "../layouts/Base.astro";
---

<Base title="Settings — SlowGuardian" description="Make SlowGuardian yours — theme, accent, and speed on slow machines. Everything applies live, no reload.">
  <section class="set-page">
    <div class="wrap">
      <div class="sechead reveal">
        <div class="ey">Make it yours</div>
        <h2>Glass that doesn't cost you speed.</h2>
        <p>One attribute on the root rethemes the whole app — no reload, no download. On older Chromebooks the blur gracefully steps down to solid glass, so nothing stutters.</p>
      </div>

      <div class="appear glass reveal">
        <div class="grp">
          <span class="lbl">Appearance</span>
          <div class="segmented" id="themeSeg" style="background:var(--glass);">
            <button data-theme="dark" class="on">Dark</button>
            <button data-theme="light">Light</button>
          </div>
        </div>
        <div class="grp">
          <span class="lbl">Accent</span>
          <div class="swatches" id="swatches">
            <button class="sw on" data-a="blue" aria-label="Blue"></button>
            <button class="sw" data-a="indigo" aria-label="Indigo"></button>
            <button class="sw" data-a="teal" aria-label="Teal"></button>
            <button class="sw" data-a="rose" aria-label="Rose"></button>
          </div>
        </div>
        <button class="btn sm" id="cloakToggle" type="button">Preview tab disguise</button>
      </div>

      <div class="setgrid reveal">
        <div class="setcard glass">
          <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h7l-1 8 10-12h-7z"></path></svg>Performance</h3>
          <div class="setrow">
            <div><div class="rt">Glass &amp; blur</div><div class="rd" id="perfNote">Auto</div></div>
            <div class="segmented" id="perfSeg" style="background:var(--glass);">
              <button data-perf="auto">Auto</button>
              <button data-perf="high">Full</button>
              <button data-perf="low">Lite</button>
            </div>
          </div>
          <div class="setdiv"></div>
          <div class="setrow">
            <div><div class="rt">For older Chromebooks</div><div class="rd">Lite drops runtime blur to solid glass — smoother on 2016–2019 machines.</div></div>
          </div>
        </div>

        <div class="setcard glass">
          <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>Privacy &amp; exit</h3>
          <div class="setrow">
            <div><div class="rt">Tab disguise</div><div class="rd">Make this tab look like Google Classroom</div></div>
            <button class="btn sm" id="cloakToggle2" type="button" style="background:var(--glass);color:var(--ink)">Toggle</button>
          </div>
          <div class="setdiv"></div>
          <div class="setrow">
            <div><div class="rt">Quick exit</div><div class="rd">Double-tap Esc → your decoy · rebindable</div></div>
            <a class="btn sm" href="/privacy" style="background:var(--glass);color:var(--ink)">Set up</a>
          </div>
          <div class="setdiv"></div>
          <div class="setrow">
            <div><div class="rt">Clear traces</div><div class="rd">Wipe history, cache &amp; local data this app made</div></div>
            <button class="btn sm" id="clearTraces" type="button" style="background:var(--glass);color:var(--ink)">Clear</button>
          </div>
        </div>

        <div class="setcard glass">
          <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16h.01"></path></svg>About</h3>
          <div class="setrow"><span class="rt">Version</span><span class="rd" style="margin:0">10.0.0 · LTS</span></div>
          <div class="setdiv"></div>
          <div class="setrow"><span class="rt">Engine</span><span class="rd" style="margin:0">Scramjet over Wisp</span></div>
          <div class="setdiv"></div>
          <div class="setrow"><span class="rt">Support window</span><span class="rd" style="margin:0">6 mo active + 6 mo security</span></div>
          <div class="setdiv"></div>
          <div class="setrow"><span class="rt">Status</span><span class="rd" style="margin:0;color:var(--ok)">● All systems online</span></div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .set-page { padding: 84px 0 var(--sp-6); }
  </style>

  <script>
    /* Performance mode + privacy actions. Theme/accent + tab-disguise (#cloakToggle)
       are wired by the Base shell; this adds the perf segmented control, a second
       disguise trigger, and clear-traces. */
    (function () {
      const root = document.documentElement;
      const w = window as any;
      function lsGet(k: string) { try { return localStorage.getItem(k); } catch (e) { return null; } }
      function lsSet(k: string, v: string) { try { localStorage.setItem(k, v); } catch (e) {} }
      function lsDel(k: string) { try { localStorage.removeItem(k); } catch (e) {} }
      function toast(m: string) { if (w.SG && w.SG.toast) w.SG.toast(m); }

      function autoDetect(): "low" | "high" {
        const mem = (navigator as any).deviceMemory;
        const cores = navigator.hardwareConcurrency;
        return ((mem && mem <= 2) || (cores && cores <= 2)) ? "low" : "high";
      }
      function currentPerf(): "auto" | "high" | "low" {
        const p = lsGet("sg:perf");
        return p === "low" || p === "high" ? p : "auto";
      }
      const perfSeg = document.getElementById("perfSeg");
      const perfNote = document.getElementById("perfNote");
      function reflectPerf(mode: string) {
        if (perfSeg) perfSeg.querySelectorAll("[data-perf]").forEach((b: any) => b.classList.toggle("on", b.getAttribute("data-perf") === mode));
        if (perfNote) {
          const eff = autoDetect() === "low" ? "Lite" : "Full glass";
          perfNote.innerHTML = mode === "auto"
            ? "Auto — this device: <b>" + eff + "</b>"
            : mode === "low" ? "Lite — solid glass, no runtime blur" : "Full glass — live blur everywhere";
        }
      }
      function applyPerf(mode: string) {
        if (mode === "low") { lsSet("sg:perf", "low"); root.dataset.perf = "low"; }
        else if (mode === "high") { lsSet("sg:perf", "high"); root.removeAttribute("data-perf"); }
        else { lsDel("sg:perf"); if (autoDetect() === "low") root.dataset.perf = "low"; else root.removeAttribute("data-perf"); }
        reflectPerf(mode);
        toast(mode === "auto" ? "Performance: Auto" : mode === "low" ? "Performance: Lite" : "Performance: Full glass");
      }
      if (perfSeg) {
        reflectPerf(currentPerf());
        perfSeg.addEventListener("click", (e: any) => { const b = e.target.closest("[data-perf]"); if (b) applyPerf(b.getAttribute("data-perf")); });
      }

      /* second disguise trigger + clear traces (Base owns the implementations) */
      const cloak2 = document.getElementById("cloakToggle2");
      if (cloak2) cloak2.addEventListener("click", () => { if (w.SG && w.SG.toggleCloak) w.SG.toggleCloak(); });
      const clr = document.getElementById("clearTraces");
      if (clr) clr.addEventListener("click", () => { if (w.SG && w.SG.clearTraces) w.SG.clearTraces(); });
    })();
  </script>
</Base>
