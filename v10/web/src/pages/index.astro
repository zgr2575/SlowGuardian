---
/**
 * index.astro — Home (Games). Hero + omnibox + meta row, then the
 * Netflix-style library. The library shelves are owned by the catalog
 * agent: fill the marked slot below (or drop in a <Library/> component).
 */
import Base from "../layouts/Base.astro";
import Library from "../components/Library.astro";

/* Honest catalog counts (static/assets/json: 284 games, 55 apps). */
const GAMES = 284;
const APPS = 55;
---

<Base title="SlowGuardian" description="A fast, private gateway for the school Chromebook. Open a site or launch a game — it loads in a blink, even on the slow machines.">
  <section class="hero">
    <div class="wrap">
      <p class="kicker reveal in">SlowGuardian&nbsp;10</p>
      <h1 class="reveal in">Everything you need.<br /><span class="soft">Nothing in your way.</span></h1>
      <p class="lede reveal in">A fast, private gateway for the school Chromebook. Open a site or launch a game — it loads in a blink, even on the slow machines.</p>
      <form class="omni glass reveal in" id="omni" action="/go" method="get">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
        <input id="omniInput" name="url" placeholder="Search the web or enter an address" aria-label="Search or enter a URL" autocomplete="off" spellcheck="false" />
        <button class="btn" type="submit">Open</button>
      </form>
      <div class="meta-row reveal in">
        <span><span class="d"></span>All systems online</span>
        <span>{GAMES} games</span>
        <span>{APPS} apps</span>
        <span>Loads in &lt;1.5s on a 2018 Chromebook</span>
      </div>
    </div>
  </section>

  <Library collection="games" />

  <script>
    /* Omnibox → /go?url=… — normalize the entry the same way the Phase 1
       proxy client does: a valid URL is passed through, a bare host gets
       https://, and anything else becomes a web search. Progressive
       enhancement: without JS the form still GETs /go?url=<raw>. */
    (function () {
      var form = document.getElementById("omni") as HTMLFormElement | null;
      var input = document.getElementById("omniInput") as HTMLInputElement | null;
      if (!form || !input) return;

      function normalize(raw: string): string {
        raw = raw.trim();
        if (!raw) return "";
        /* looks like a domain/URL (has a dot or scheme, no spaces) */
        var looksUrlish = /^[a-z][a-z0-9+.-]*:\/\//i.test(raw) ||
          (!/\s/.test(raw) && /\.[a-z]{2,}(\/|$|:)/i.test(raw));
        if (looksUrlish) {
          try { return new URL(raw).toString(); } catch (e) { return "https://" + raw; }
        }
        return "https://www.google.com/search?q=" + encodeURIComponent(raw);
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var url = normalize(input!.value);
        if (!url) {
          if ((window as any).SG) (window as any).SG.toast("Type a site or a search first");
          input!.focus();
          return;
        }
        window.location.href = "/go?url=" + encodeURIComponent(url);
      });
    })();
  </script>
</Base>
