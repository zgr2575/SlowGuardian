---
/**
 * go.astro — the proxy workspace (Liquid Glass) with a MULTI-TAB browser.
 *
 * Each tab is its own Scramjet frame. The proxy wiring is a 1:1 port of the
 * VERIFIED Phase 1 client (v10/public/boot.js + index.html):
 *   - /scram/scramjet.all.js and /baremux/index.js are loaded as classic
 *     <script is:inline> in <head> so they define $scramjetLoadController and
 *     the global BareMux BEFORE the bundled module below runs.
 *   - $scramjetLoadController() -> new ScramjetController({ prefix:"/scramjet/",
 *     files:{ all, sync, wasm } }) -> scramjet.init()
 *   - new BareMux.BareMuxConnection("/baremux/worker.js")
 *   - navigator.serviceWorker.register("/sw.js", { scope:"/" })
 *   - connection.setTransport("/epoxy/index.mjs", [{ wisp: ws(s)://host/wisp/ }])
 *   - per tab: scramjet.createFrame(); frame.go(url)
 *
 * The Express server (v10/src/server.js) serves /scram /baremux /epoxy and the
 * /wisp/ upgrade — the frontend never bundles the engine, it only talks to it.
 *
 * ?url= auto-opens in the first tab. A visible, always-available Quick Exit
 * button does top.location.replace() to the decoy (sg:panicUrl).
 */
import Base from "../layouts/Base.astro";
---

<Base
  title="New Tab"
  description="Open any site through SlowGuardian's fast, private gateway."
>
  <Fragment slot="head">
    {/* Load order matters — these define $scramjetLoadController + global BareMux,
        exactly as the verified Phase 1 index.html does. Served by Express. */}
    <script is:inline src="/scram/scramjet.all.js"></script>
    <script is:inline src="/baremux/index.js"></script>
  </Fragment>

  <section class="gg-page">
    <div class="gg-wrap">
      <div class="gg-shell glass reveal in">
        <!-- ---------- tab strip ---------- -->
        <div class="gg-tabstrip">
          <div class="gg-tabs" id="ggTabs" role="tablist" aria-label="Open tabs"></div>
          <button class="gg-newtab" id="ggNewTab" type="button" title="New tab" aria-label="New tab">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
          </button>
        </div>

        <!-- ---------- toolbar / Dynamic-Island-consistent omnibox ---------- -->
        <div class="gg-toolbar">
          <div class="gg-nav">
            <button class="gg-navbtn" id="ggBack" type="button" title="Back" aria-label="Back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <button class="gg-navbtn" id="ggFwd" type="button" title="Forward" aria-label="Forward">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
            </button>
            <button class="gg-navbtn" id="ggReload" type="button" title="Reload" aria-label="Reload">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"></path></svg>
            </button>
          </div>

          <form class="gg-omni" id="ggOmni" autocomplete="off">
            <span class="gg-scheme" id="ggScheme" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"></path></svg>
            </span>
            <input
              id="ggUrl"
              type="text"
              inputmode="url"
              placeholder="Search the web or enter an address"
              aria-label="Address bar"
              spellcheck="false"
            />
          </form>

          <button class="gg-exit" id="ggExit" type="button" title="Quick exit — replaces this tab with your decoy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg>
            <span class="lbl">Exit</span>
          </button>
        </div>

        <div class="gg-progress" id="ggProgress" aria-hidden="true"></div>

        <!-- ---------- views: one Scramjet frame per tab, only active shown ---------- -->
        <div class="gg-views" id="ggViews">
          <div class="gg-start" id="ggStart">
            <span class="gg-mark">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"></path></svg>
            </span>
            <h2>Where to?</h2>
            <p>Type an address or a search. It opens right here — a real tab, private and fast.</p>
            <form class="gg-startomni glass" id="ggStartForm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
              <input id="ggStartUrl" type="text" placeholder="Search or enter an address" aria-label="Search or enter an address" spellcheck="false" />
              <button class="btn" type="submit">Open</button>
            </form>
            <div class="gg-chips">
              <button class="gg-chip" type="button" data-openurl="https://www.google.com/">Google</button>
              <button class="gg-chip" type="button" data-openurl="https://www.youtube.com/">YouTube</button>
              <button class="gg-chip" type="button" data-openurl="https://en.wikipedia.org/">Wikipedia</button>
              <button class="gg-chip" type="button" data-openurl="https://www.reddit.com/">Reddit</button>
              <button class="gg-chip" type="button" data-openurl="https://github.com/">GitHub</button>
            </div>
            <p class="gg-fineprint">Quiet on a shared screen — not a way past network filtering or device monitoring. <a href="/privacy">What that means →</a></p>
          </div>
        </div>
      </div>

      <p class="gg-status" id="ggStatus" role="status" aria-live="polite"></p>
    </div>
  </section>

  <style is:global>
    /* ---- proxy workspace (go.astro). is:global so JS-created tab elements
       still pick these up (Astro's scoped CSS only tags static markup). ---- */
    .gg-page { padding-top: 80px; padding-bottom: var(--sp-6); }
    .gg-wrap { max-width: min(1440px, 100% - 28px); margin: 0 auto; padding: 0 var(--sp-4); position: relative; z-index: 1; }

    .gg-shell { border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; }

    /* tab strip */
    .gg-tabstrip { display: flex; align-items: center; gap: 6px; padding: 8px 10px 0; border-bottom: 1px solid var(--glass-brd); }
    .gg-tabs { display: flex; gap: 5px; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; padding-bottom: 8px; }
    .gg-tabs::-webkit-scrollbar { display: none; }
    .gg-tab { display: inline-flex; align-items: center; gap: 8px; flex: 0 1 190px; min-width: 118px; max-width: 220px;
      padding: 8px 8px 8px 11px; border-radius: 12px; background: var(--glass); border: 1px solid transparent;
      color: var(--ink-2); cursor: pointer; transition: background .18s, color .18s, box-shadow .18s; user-select: none; }
    .gg-tab:hover { background: var(--glass-2); color: var(--ink); }
    .gg-tab.on { background: var(--glass-strong); color: var(--ink); border-color: var(--glass-brd); box-shadow: inset 0 1px 0 var(--hi); }
    .gg-tab .gg-fav { width: 16px; height: 16px; border-radius: 4px; flex-shrink: 0; display: grid; place-items: center; overflow: hidden; color: var(--ink-3); }
    .gg-tab.on .gg-fav { color: var(--accent-2); }
    .gg-tab .gg-fav img { width: 16px; height: 16px; object-fit: cover; border-radius: 3px; display: block; }
    .gg-tab .gg-fav svg { width: 15px; height: 15px; }
    .gg-tab .gg-ti { flex: 1; min-width: 0; font-size: 12.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gg-tab .gg-x { width: 18px; height: 18px; flex-shrink: 0; display: grid; place-items: center; border: none; background: none; color: inherit;
      border-radius: 50%; opacity: .55; cursor: pointer; transition: opacity .15s, background .15s; }
    .gg-tab .gg-x:hover { opacity: 1; background: var(--glass-2); }
    .gg-tab .gg-x svg { width: 12px; height: 12px; }
    .gg-spin { animation: ggspin .8s linear infinite; }
    @keyframes ggspin { to { transform: rotate(360deg); } }

    .gg-newtab { flex: 0 0 auto; width: 32px; height: 32px; margin-bottom: 8px; display: grid; place-items: center; cursor: pointer;
      border-radius: 9px; background: var(--glass); border: 1px solid var(--glass-brd); color: var(--ink-2); transition: .2s; }
    .gg-newtab:hover { color: var(--ink); background: var(--glass-2); }
    .gg-newtab svg { width: 15px; height: 15px; }

    /* toolbar */
    .gg-toolbar { display: flex; align-items: center; gap: 9px; padding: 11px 12px; }
    .gg-nav { display: flex; gap: 4px; flex-shrink: 0; }
    .gg-navbtn { width: 34px; height: 34px; display: grid; place-items: center; cursor: pointer; border-radius: 50%; flex-shrink: 0;
      background: var(--glass); border: 1px solid var(--glass-brd); color: var(--ink-2); transition: .2s; }
    .gg-navbtn:hover { color: var(--ink); background: var(--glass-2); }
    .gg-navbtn svg { width: 16px; height: 16px; }

    .gg-omni { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; border-radius: var(--r-pill);
      padding: 8px 16px; background: var(--glass); border: 1px solid var(--glass-brd); box-shadow: inset 0 1px 0 var(--hi); transition: box-shadow .2s, border-color .2s; }
    .gg-omni:focus-within { border-color: var(--accent); box-shadow: inset 0 1px 0 var(--hi), 0 0 0 3px var(--accent-tint); }
    .gg-scheme { display: grid; place-items: center; color: var(--ink-3); flex-shrink: 0; }
    .gg-scheme svg { width: 16px; height: 16px; display: block; }
    .gg-scheme.secure { color: var(--ok); }
    .gg-omni input { flex: 1; min-width: 0; border: none; outline: none; background: none; color: var(--ink);
      font-family: var(--font); font-size: 14px; padding: 5px 0; }
    .gg-omni input::placeholder { color: var(--ink-3); }

    .gg-exit { flex-shrink: 0; display: inline-flex; align-items: center; gap: 7px; cursor: pointer; border-radius: var(--r-pill);
      padding: 9px 15px; font-family: var(--font); font-size: 13.5px; font-weight: 600; color: var(--err);
      background: color-mix(in srgb, var(--err) 12%, transparent); border: 1px solid color-mix(in srgb, var(--err) 34%, transparent); transition: .18s; }
    .gg-exit:hover { background: color-mix(in srgb, var(--err) 20%, transparent); }
    .gg-exit svg { width: 15px; height: 15px; }

    /* thin loading bar */
    .gg-progress { height: 2px; width: 100%; position: relative; overflow: hidden; background: transparent; }
    .gg-progress::before { content: ""; position: absolute; left: 0; top: 0; height: 100%; width: 38%;
      background: linear-gradient(90deg, transparent, var(--accent-2), transparent); transform: translateX(-120%); }
    .gg-progress.on::before { animation: ggbar 1.05s ease-in-out infinite; }
    @keyframes ggbar { to { transform: translateX(320%); } }

    /* views */
    .gg-views { position: relative; height: clamp(420px, 68vh, 780px); background: #0a0b10; }
    :root[data-theme="light"] .gg-views { background: #f4f6fb; }
    .gg-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; background: #fff; }

    /* new-tab / empty state */
    .gg-start { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 16px; text-align: center; padding: 28px; }
    .gg-start .gg-mark { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; color: var(--on-accent);
      background: linear-gradient(160deg, var(--accent-2), var(--accent)); box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 6px 20px var(--accent-tint); }
    .gg-start .gg-mark svg { width: 22px; height: 22px; }
    .gg-start h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 600; letter-spacing: -0.03em; }
    .gg-start p { color: var(--ink-2); font-size: 0.98rem; max-width: 42ch; }
    .gg-startomni { width: min(520px, 100%); display: flex; align-items: center; gap: 8px; border-radius: var(--r-pill); padding: 8px 8px 8px 20px; margin-top: 4px; }
    .gg-startomni svg { width: 18px; height: 18px; color: var(--ink-3); flex-shrink: 0; }
    .gg-startomni input { flex: 1; min-width: 0; border: none; outline: none; background: none; color: var(--ink); font-family: var(--font); font-size: 15px; padding: 11px 0; }
    .gg-startomni input::placeholder { color: var(--ink-3); }
    .gg-startomni:focus-within { border-color: var(--accent); box-shadow: inset 0 1px 0 var(--hi), var(--sh-2), 0 0 0 4px var(--accent-tint); }
    .gg-chips { display: flex; gap: 9px; flex-wrap: wrap; justify-content: center; }
    .gg-chip { cursor: pointer; border-radius: var(--r-pill); padding: 8px 15px; font-family: var(--font); font-size: 13px; font-weight: 500;
      color: var(--ink-2); background: var(--glass); border: 1px solid var(--glass-brd); box-shadow: inset 0 1px 0 var(--hi); transition: .18s; }
    .gg-chip:hover { color: var(--ink); background: var(--glass-2); transform: translateY(-1px); }
    .gg-fineprint { font-size: 12.5px; color: var(--ink-3); margin-top: 4px; }
    .gg-fineprint a { color: var(--accent-2); }
    .gg-fineprint a:hover { text-decoration: underline; }

    .gg-status { margin: 12px 2px 0; min-height: 16px; font-size: 12.5px; color: var(--ink-3); font-family: var(--mono); }

    @media (max-width: 640px) {
      .gg-page { padding-top: 72px; }
      .gg-exit .lbl { display: none; }
      .gg-exit { padding: 9px 11px; }
      .gg-views { height: 66vh; }
    }
  </style>

  <script>
    /* Multi-tab Scramjet browser — verified Phase 1 wiring, one frame per tab. */
    (function () {
      const w = window as any;

      const viewsEl = document.getElementById("ggViews");
      const startEl = document.getElementById("ggStart");
      const tabsEl = document.getElementById("ggTabs");
      const urlInput = document.getElementById("ggUrl") as HTMLInputElement;
      const omniForm = document.getElementById("ggOmni") as HTMLFormElement;
      const startForm = document.getElementById("ggStartForm") as HTMLFormElement | null;
      const startInput = document.getElementById("ggStartUrl") as HTMLInputElement | null;
      const progress = document.getElementById("ggProgress");
      const schemeEl = document.getElementById("ggScheme");
      const statusEl = document.getElementById("ggStatus");
      if (!viewsEl || !tabsEl || !urlInput || !omniForm) return;

      function toast(msg: string) { if (w.SG && w.SG.toast) w.SG.toast(msg); }
      function setStatus(m: string) { if (statusEl) statusEl.textContent = m || ""; }
      function lsGet(k: string) { try { return localStorage.getItem(k); } catch (e) { return null; } }

      /* ---------- engine bootstrap (mirrors boot.js) ---------- */
      let scramjet: any = null;
      let connection: any = null;
      let ready: Promise<any>;

      if (w.$scramjetLoadController && w.BareMux) {
        const { ScramjetController } = w.$scramjetLoadController();
        scramjet = new ScramjetController({
          prefix: "/scramjet/",
          files: {
            all: "/scram/scramjet.all.js",
            sync: "/scram/scramjet.sync.js",
            wasm: "/scram/scramjet.wasm.wasm",
          },
        });
        scramjet.init(); // publishes the shared config the SW reads via loadConfig()
        connection = new w.BareMux.BareMuxConnection("/baremux/worker.js");

        const registerSW = async () => {
          if (!navigator.serviceWorker) {
            const local = ["localhost", "127.0.0.1"].includes(location.hostname);
            if (location.protocol !== "https:" && !local) throw new Error("Service workers require https (or localhost).");
            throw new Error("Service workers unsupported in this browser.");
          }
          await navigator.serviceWorker.register("/sw.js", { scope: "/" });
          await navigator.serviceWorker.ready;
        };
        const setEpoxyTransport = async () => {
          const wispUrl = (location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/";
          if ((await connection.getTransport()) !== "/epoxy/index.mjs") {
            await connection.setTransport("/epoxy/index.mjs", [{ wisp: wispUrl }]);
          }
        };
        // Eagerly register + set transport so the SW is controlling before the
        // first navigation. Both calls are idempotent.
        setStatus("starting proxy…");
        ready = registerSW().then(setEpoxyTransport).then(() => setStatus("ready"));
        ready.catch((err: any) => { setStatus("init error: " + ((err && err.message) || err)); toast("Proxy init error — " + ((err && err.message) || err)); });
      } else {
        setStatus("proxy engine not loaded (serve via the SlowGuardian server)");
        ready = Promise.reject(new Error("Proxy engine not loaded"));
        ready.catch(() => {});
      }

      /* ---------- entry normalization (same rules as the home omnibox) ---------- */
      function normalize(raw: string) {
        raw = (raw || "").trim();
        if (!raw) return "";
        const looksUrlish = /^[a-z][a-z0-9+.-]*:\/\//i.test(raw) || (!/\s/.test(raw) && /\.[a-z]{2,}(\/|$|:|\?)/i.test(raw));
        if (looksUrlish) { try { return new URL(raw).toString(); } catch (e) { return "https://" + raw; } }
        return "https://www.google.com/search?q=" + encodeURIComponent(raw);
      }
      function hostFrom(u: string) { try { return new URL(u).hostname.replace(/^www\./, ""); } catch (e) { return u || "New tab"; } }

      const GLOBE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"></path></svg>';
      const LOCK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>';
      const CLOSE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"></path></svg>';
      const SPINNER = '<svg class="gg-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M21 12a9 9 0 1 1-6.2-8.5" stroke-linecap="round"></path></svg>';

      /* ---------- tab state ---------- */
      type Tab = { id: number; frame: any; el: any; url: string; title: string; favicon: string; loading: boolean };
      const tabs: Tab[] = [];
      let activeId: number | null = null;
      let seq = 0;

      function activeTab(): Tab | null { return tabs.find((t) => t.id === activeId) || null; }
      function setProgress(on: boolean) { if (progress) progress.classList.toggle("on", !!on); }

      function renderTabs() {
        tabsEl.innerHTML = "";
        tabs.forEach((t) => {
          const el = document.createElement("div");
          el.className = "gg-tab" + (t.id === activeId ? " on" : "");
          el.setAttribute("role", "tab");
          el.setAttribute("aria-selected", t.id === activeId ? "true" : "false");
          el.title = t.title || hostFrom(t.url);

          const fav = document.createElement("span");
          fav.className = "gg-fav";
          if (t.loading) fav.innerHTML = SPINNER;
          else if (t.favicon) {
            const im = document.createElement("img");
            im.src = t.favicon; im.alt = "";
            im.addEventListener("error", () => { fav.innerHTML = GLOBE; });
            fav.appendChild(im);
          } else fav.innerHTML = GLOBE;

          const ti = document.createElement("span");
          ti.className = "gg-ti";
          ti.textContent = t.title || hostFrom(t.url) || "New tab";

          const x = document.createElement("button");
          x.className = "gg-x"; x.type = "button";
          x.setAttribute("aria-label", "Close tab");
          x.innerHTML = CLOSE;
          x.addEventListener("click", (e) => { e.stopPropagation(); closeTab(t.id); });

          el.appendChild(fav); el.appendChild(ti); el.appendChild(x);
          el.addEventListener("click", () => switchTab(t.id));
          tabsEl.appendChild(el);
        });
      }

      function updateAddressBar() {
        const t = activeTab();
        const u = t ? (t.url || "") : "";
        if (document.activeElement !== urlInput) urlInput.value = u;
        if (schemeEl) {
          const secure = /^https:/i.test(u);
          schemeEl.innerHTML = secure ? LOCK : GLOBE;
          schemeEl.classList.toggle("secure", secure);
        }
      }

      function syncDocTitle() {
        const t = activeTab();
        if (!t) return;
        /* respect an active tab-disguise — never override the cloak title */
        if (document.documentElement.dataset.cloaked === "1") return;
        document.title = t.title || "New Tab";
      }

      function showActive() {
        tabs.forEach((t) => { if (t.el) t.el.style.display = t.id === activeId ? "block" : "none"; });
        const t = activeTab();
        const hasFrame = !!(t && t.el);
        if (startEl) startEl.style.display = hasFrame ? "none" : "flex";
        setProgress(!!(t && t.loading));
        updateAddressBar();
        renderTabs();
        syncDocTitle();
      }

      function switchTab(id: number) { activeId = id; showActive(); const t = activeTab(); if (t && !t.el) setTimeout(() => urlInput.focus(), 0); }

      function newTab(url?: string): Tab {
        const tab: Tab = { id: ++seq, frame: null, el: null, url: "", title: "New tab", favicon: "", loading: false };
        tabs.push(tab);
        activeId = tab.id;
        showActive();
        if (url) openInTab(tab, url);
        else { urlInput.value = ""; setTimeout(() => urlInput.focus(), 0); }
        return tab;
      }

      function closeTab(id: number) {
        const idx = tabs.findIndex((t) => t.id === id);
        if (idx < 0) return;
        const tab = tabs[idx];
        tabs.splice(idx, 1);
        try { if (tab.el && tab.el.parentNode) tab.el.parentNode.removeChild(tab.el); } catch (e) {}
        try { if (tab.frame && typeof tab.frame.destroy === "function") tab.frame.destroy(); } catch (e) {}
        if (activeId === id) {
          const next = tabs[idx] || tabs[idx - 1];
          if (next) { activeId = next.id; showActive(); }
          else newTab();
        } else renderTabs();
      }

      function wireFrame(tab: Tab) {
        /* Scramjet frame URL changes (feature-detected — falls back to the
           user-entered URL if the build doesn't emit the event). */
        try {
          if (tab.frame && typeof tab.frame.addEventListener === "function") {
            tab.frame.addEventListener("urlchange", (e: any) => {
              const u = e && (e.url || (e.detail && e.detail.url));
              if (u) { tab.url = u; if (tab.id === activeId) updateAddressBar(); }
            });
          }
        } catch (e) {}
        tab.el.addEventListener("load", () => {
          tab.loading = false;
          if (tab.id === activeId) { setProgress(false); setStatus(""); }
          readMeta(tab, 0);
        });
      }

      /* Best-effort title/favicon read. Frames are same-origin (Scramjet serves
         them under our /scramjet/ prefix), so contentDocument is readable. */
      function readMeta(tab: Tab, tries: number) {
        let title = "", fav = "";
        try {
          const doc = tab.el && tab.el.contentDocument;
          if (doc) {
            title = (doc.title || "").trim();
            const link = doc.querySelector('link[rel~="icon"], link[rel="shortcut icon"], link[rel="apple-touch-icon"]') as HTMLLinkElement | null;
            if (link && link.href) fav = link.href;
          }
        } catch (e) {}
        if (title) tab.title = title;
        else if (!tab.title || tab.title === "New tab") tab.title = hostFrom(tab.url);
        if (fav) tab.favicon = fav;
        renderTabs();
        if (tab.id === activeId) { updateAddressBar(); syncDocTitle(); }
        const delays = [300, 900, 2200];
        if (tries < delays.length) setTimeout(() => readMeta(tab, tries + 1), delays[tries]);
      }

      async function openInTab(tab: Tab, url: string) {
        if (!url) return;
        tab.loading = true;
        tab.url = url;
        tab.title = hostFrom(url);
        if (tab.id === activeId) { updateAddressBar(); setProgress(true); if (startEl) startEl.style.display = "none"; setStatus("connecting to " + hostFrom(url) + "…"); }
        renderTabs();
        try {
          await ready;
          if (!tab.frame) {
            tab.frame = scramjet.createFrame();
            tab.el = tab.frame.frame;
            tab.el.className = "gg-frame";
            tab.el.setAttribute("allow", "autoplay; fullscreen; clipboard-read; clipboard-write; encrypted-media; gamepad; picture-in-picture");
            tab.el.style.display = tab.id === activeId ? "block" : "none";
            wireFrame(tab);
            viewsEl.appendChild(tab.el);
            if (tab.id === activeId && startEl) startEl.style.display = "none";
          }
          tab.frame.go(url); // scramjet.encodeUrl(url) + points the iframe at the prefix
        } catch (e: any) {
          tab.loading = false;
          renderTabs();
          if (tab.id === activeId) { setProgress(false); setStatus("couldn't reach the proxy engine"); }
          toast("Couldn't open — " + ((e && e.message) || e));
        }
      }

      /* ---------- toolbar wiring ---------- */
      omniForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const url = normalize(urlInput.value);
        if (!url) { toast("Type a site or a search"); return; }
        let t = activeTab(); if (!t) t = newTab();
        openInTab(t, url);
        urlInput.blur();
      });
      if (startForm && startInput) {
        startForm.addEventListener("submit", (e) => {
          e.preventDefault();
          const url = normalize(startInput.value);
          if (!url) { toast("Type a site or a search"); return; }
          let t = activeTab(); if (!t) t = newTab();
          openInTab(t, url);
        });
      }

      const newTabBtn = document.getElementById("ggNewTab");
      if (newTabBtn) newTabBtn.addEventListener("click", () => newTab());

      const backBtn = document.getElementById("ggBack");
      if (backBtn) backBtn.addEventListener("click", () => { const t = activeTab(); try { if (t && t.el && t.el.contentWindow) t.el.contentWindow.history.back(); } catch (e) {} });
      const fwdBtn = document.getElementById("ggFwd");
      if (fwdBtn) fwdBtn.addEventListener("click", () => { const t = activeTab(); try { if (t && t.el && t.el.contentWindow) t.el.contentWindow.history.forward(); } catch (e) {} });
      const reloadBtn = document.getElementById("ggReload");
      if (reloadBtn) reloadBtn.addEventListener("click", () => {
        const t = activeTab(); if (!t) return;
        try { if (t.el && t.el.contentWindow) { t.loading = true; setProgress(true); renderTabs(); t.el.contentWindow.location.reload(); return; } } catch (e) {}
        if (t.url) openInTab(t, t.url);
      });

      document.querySelectorAll("[data-openurl]").forEach((b) => {
        b.addEventListener("click", () => {
          const u = (b as HTMLElement).getAttribute("data-openurl") || "";
          let t = activeTab(); if (!t) t = newTab();
          openInTab(t, u);
        });
      });

      /* ---------- Quick Exit — always available, replaces the TOP tab ---------- */
      function quickExit() {
        let url = lsGet("sg:panicUrl") || "https://classroom.google.com/";
        try { (window.top || window).location.replace(url); } catch (e) { location.replace(url); }
      }
      const exitBtn = document.getElementById("ggExit");
      if (exitBtn) exitBtn.addEventListener("click", quickExit);

      /* Optional rebindable single-key panic (sg:panicKey). Base already owns
         the global double-Esc; this adds the user's chosen key on the browser
         page. Never fires while typing in a field. */
      document.addEventListener("keydown", (e) => {
        const key = lsGet("sg:panicKey");
        if (!key) return;
        const el = e.target as HTMLElement;
        const tag = (el && el.tagName || "").toLowerCase();
        if (tag === "input" || tag === "textarea" || (el && el.isContentEditable)) return;
        if (e.key && e.key.toLowerCase() === key.toLowerCase()) { e.preventDefault(); quickExit(); }
      });

      /* ---------- boot: honor ?url=, else an empty start tab ---------- */
      const params = new URLSearchParams(location.search);
      const initial = params.get("url");
      newTab(initial ? normalize(initial) : "");
    })();
  </script>
</Base>
